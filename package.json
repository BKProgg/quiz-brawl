{
  "name": "quiz-brawl",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-questions.mjs",
    "assets": "node scripts/process-assets.mjs",
    "build:client": "esbuild src/client/main.ts src/client/admin-main.ts --bundle --format=esm --target=es2022 --outdir=public/build",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261014.1",
    "esbuild": "0.28.2",
    "pngjs": "7.0.0",
    "typescript": "6.0.3",
    "vitest": "5.0.4",
    "wrangler": "4.151.0"
  }
}
